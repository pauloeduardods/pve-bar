<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.pve-bar" path="/org/gnome/shell/extensions/pve-bar/">

    <!-- Which server and node the panel shows ('' = automatic) -->
    <key name="server" type="s"><default>''</default><summary>Server name ('' = the first one)</summary></key>
    <key name="node" type="s"><default>''</default><summary>Node name ('' = the first online node of the server)</summary></key>

    <key name="show-icons" type="b"><default>true</default><summary>Show icons</summary></key>

    <!-- The top-bar layout (lib/layout.js); '' = build it once from the settings above -->
    <key name="panel-layout" type="s">
      <default>''</default>
      <summary>Top-bar layout (JSON)</summary>
      <description>Segments, their targets, templates and graphs. Edited in Settings → Layout. Empty on a fresh install: the extension then stores the layout the server, node and show-icons settings describe.</description>
    </key>

    <!-- Placement -->
    <key name="panel-position" type="s">
      <choices><choice value="left"/><choice value="center"/><choice value="right"/></choices>
      <default>'right'</default>
      <summary>Position in the top bar</summary>
    </key>
    <key name="panel-index" type="i"><range min="0" max="20"/><default>0</default><summary>Order within the area</summary></key>

    <!-- Thresholds -->
    <key name="cpu-warm" type="i"><range min="1" max="110"/><default>70</default><summary>CPU %: warm from</summary></key>
    <key name="cpu-hot" type="i"><range min="1" max="110"/><default>90</default><summary>CPU %: hot from</summary></key>
    <key name="mem-warm" type="i"><range min="1" max="110"/><default>80</default><summary>RAM %: warm from</summary></key>
    <key name="mem-hot" type="i"><range min="1" max="110"/><default>95</default><summary>RAM %: hot from</summary></key>
    <key name="temp-warm" type="i"><range min="30" max="110"/><default>70</default><summary>Temperature (°C): warm from</summary></key>
    <key name="temp-hot" type="i"><range min="30" max="110"/><default>85</default><summary>Temperature (°C): hot from</summary></key>
    <key name="disk-warm" type="i"><range min="1" max="110"/><default>80</default><summary>Node root disk %: warm from</summary></key>
    <key name="disk-hot" type="i"><range min="1" max="110"/><default>90</default><summary>Node root disk %: hot from</summary></key>
    <key name="fs-warm" type="i"><range min="1" max="110"/><default>80</default><summary>Disk inside a guest %: warm from</summary></key>
    <key name="fs-hot" type="i"><range min="1" max="110"/><default>90</default><summary>Disk inside a guest %: hot from</summary></key>

    <!-- Colours (any CSS colour; empty = theme colour) -->
    <key name="color-normal" type="s"><default>''</default><summary>Normal color</summary></key>
    <key name="color-warm" type="s"><default>'#f8e45c'</default><summary>Warm color</summary></key>
    <key name="color-hot" type="s"><default>'#f66151'</default><summary>Hot color</summary></key>

    <!-- Alerts -->
    <key name="alert-temp" type="b"><default>true</default><summary>Notify when a host stays hot</summary></key>
    <key name="alert-temp-limit" type="i"><range min="30" max="110"/><default>85</default><summary>Temperature alert: from (°C)</summary></key>
    <key name="alert-temp-seconds" type="i"><range min="2" max="3600"/><default>60</default><summary>Temperature alert: held for (seconds)</summary></key>
    <key name="alert-mem" type="b"><default>true</default><summary>Notify when a host's RAM stays full</summary></key>
    <key name="alert-mem-limit" type="i"><range min="10" max="100"/><default>95</default><summary>RAM alert: from (%)</summary></key>
    <key name="alert-mem-seconds" type="i"><range min="2" max="3600"/><default>120</default><summary>RAM alert: held for (seconds)</summary></key>
    <key name="alert-disk" type="b"><default>true</default><summary>Notify when a host's disk is nearly full</summary></key>
    <key name="alert-disk-limit" type="i"><range min="10" max="100"/><default>90</default><summary>Disk alert: from (%)</summary></key>
    <key name="alert-down" type="b"><default>true</default><summary>Notify when a server is unreachable</summary></key>
    <key name="alert-down-seconds" type="i"><range min="10" max="3600"/><default>120</default><summary>Unreachable alert: after (seconds)</summary></key>
    <key name="alert-guest-stopped" type="b"><default>false</default><summary>Notify when a guest stops</summary></key>
    <key name="alert-guests" type="as"><default>[]</default><summary>Guests (server/vmid) the stop alert covers; empty = all</summary></key>
    <key name="alert-guest-started" type="b"><default>false</default><summary>Notify when a guest starts</summary></key>
    <key name="alert-test" type="i"><default>0</default><summary>Counter the Test notification button bumps</summary></key>
  </schema>
</schemalist>
